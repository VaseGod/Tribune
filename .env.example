# TRIBUNE Environment Configuration Example
# Copy to .env and customize as needed.

# Active Provider Selection: local_rules, openai_compat, openai, anthropic, deepseek, vllm, router
TRIBUNE_PROVIDER=local_rules

# OpenAI API Settings
TRIBUNE_OPENAI_BASE_URL=https://api.openai.com/v1
TRIBUNE_OPENAI_API_KEY=sk-proj-your-key-here
TRIBUNE_OPENAI_MODEL=gpt-4o-mini

# Anthropic API Settings
TRIBUNE_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
TRIBUNE_ANTHROPIC_API_KEY=sk-ant-your-key-here
TRIBUNE_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# DeepSeek API Settings (DeepSeek-V4-Flash reasoning_effort: low, medium, high)
TRIBUNE_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
TRIBUNE_DEEPSEEK_API_KEY=sk-ds-your-key-here
TRIBUNE_DEEPSEEK_MODEL=deepseek-v4-flash
TRIBUNE_DEEPSEEK_REASONING_EFFORT=medium

# Open-Weight / vLLM Local Serving Settings
TRIBUNE_VLLM_BASE_URL=http://localhost:8000/v1
TRIBUNE_VLLM_API_KEY=token-vllm-local
TRIBUNE_VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Local Quantized Fallback Settings (3-bit MoE local server failover)
TRIBUNE_LOCAL_FALLBACK_URL=http://localhost:8001/v1
TRIBUNE_LOCAL_FALLBACK_MODEL=local-quant-moe-3bit
TRIBUNE_ENABLE_LOCAL_FALLBACK=true

# Cost Accounting & Pricing Table Path
TRIBUNE_PRICING_PATH=tribune/eval/pricing.json
TRIBUNE_PRICING_DATE=

# Static Analysis Execution
TRIBUNE_SEMGREP_BINARY=semgrep
TRIBUNE_STATIC_ANALYSIS_TIMEOUT_S=30.0

# Tiered Router Defaults
DEFAULT_TIER1_MODEL=deepseek-v4-flash
DEFAULT_TIER2_MODEL=claude-3-5-sonnet-20241022

# ---- Hardened memory & execution roadmap (safe defaults; never commit secrets) ----
# Protocol-Aware Retention
TRIBUNE_RETENTION_ENABLED=trueTRIBUNE_RETENTION_MAX_TOKENS=32000
TRIBUNE_RETENTION_MAX_EVENTS=200
TRIBUNE_RETENTION_EPHEMERAL_TTL_S=3600
TRIBUNE_RETENTION_COLD_PATH=.tribune/cold_observations.jsonl
TRIBUNE_RETENTION_DEBUG_MODE=false
TRIBUNE_RETENTION_BLOCK_LOOPS=false
# Token counting: char (default heuristic) or tiktoken (real tokenizer, needs package)
TRIBUNE_TOKEN_COUNTER=char
# Cold storage encryption at rest (Fernet key; or _FILE/_CMD via secret chain; needs tribune[security])
# TRIBUNE_RETENTION_COLD_ENCRYPT_KEY=
# Consolidation schema IR + HMAC provenance (set a real secret in production)
TRIBUNE_CONSOLIDATION_SCHEMA_ENFORCED=true
TRIBUNE_HMAC_KEY_ID=k1
# TRIBUNE_HMAC_SECRET=replace-me-via-secret-manager
# ...or file / command refs (preferred in prod):
# TRIBUNE_HMAC_SECRET_FILE=/run/secrets/tribune_hmac
# TRIBUNE_HMAC_SECRET_CMD=vault kv get -field=secret secret/tribune/hmac
# Sliding Intent Graph
TRIBUNE_INTENT_GRAPH_ENABLED=true
TRIBUNE_INTENT_WINDOW=8
TRIBUNE_INTENT_DECAY_LAMBDA=0.15
TRIBUNE_INTENT_TAU_THREAT=0.45
# Extra threat exemplars JSON ({name: [keywords]}), e.g. grown from incidents
# TRIBUNE_INTENT_THREAT_LIBRARY=config/threat_library.json
# Agentic MapReduce
TRIBUNE_MAPREDUCE_ENABLED=true
TRIBUNE_MAPREDUCE_WORKERS=4
TRIBUNE_MAPREDUCE_SHARD_SIZE=64
# Reasoning budget + speculative embeddings
TRIBUNE_REASONING_BUDGET_TOKENS=4000
TRIBUNE_SPECULATIVE_EMBEDDING=true
